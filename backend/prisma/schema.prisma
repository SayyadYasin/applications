generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PARTNER
  ADMIN
  SUPER_ADMIN
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  ASSIGNED
  PARTNER_EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentMethod {
  ONLINE
  UPI
  CASH
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TxnType {
  CREDIT
  DEBIT
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DiscountType {
  PERCENT
  FLAT
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

model Town {
  id       String    @id @default(cuid())
  name     String
  state    String
  active   Boolean   @default(true)
  lat      Float
  lng      Float
  users    User[]
  services Service[]
  banners  Banner[]

  @@unique([name, state])
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  googleId     String?  @unique
  name         String
  avatarUrl    String?
  role         Role     @default(CUSTOMER)
  language     String   @default("en")
  isActive     Boolean  @default(true)
  townId       String?
  town         Town?    @relation(fields: [townId], references: [id])
  referralCode String   @unique @default(cuid())
  referredById String?
  referredBy   User?    @relation("Referral", fields: [referredById], references: [id])
  referrals    User[]   @relation("Referral")
  fcmToken     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer      Customer?
  partner       Partner?
  wallet        Wallet?
  addresses     Address[]
  notifications Notification[]
  tickets       SupportTicket[]
  sentMessages  ChatMessage[]
  otps          Otp[]
}

model Otp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([phone])
}

model Customer {
  id             String            @id @default(cuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id])
  loyaltyPoints  Int               @default(0)
  membershipId   String?
  membership     MembershipPlan?   @relation(fields: [membershipId], references: [id])
  membershipEnds DateTime?
  bookings       Booking[]
  favorites      FavoritePartner[]
}

model Address {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  label     String
  line1     String
  line2     String?
  city      String
  pincode   String
  lat       Float
  lng       Float
  isDefault Boolean   @default(false)
  bookings  Booking[]
}

model Partner {
  id             String             @id @default(cuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id])
  kycStatus      KycStatus          @default(PENDING)
  isOnline       Boolean            @default(false)
  lat            Float?
  lng            Float?
  radiusKm       Float              @default(10)
  ratingAvg      Float              @default(0)
  ratingCount    Int                @default(0)
  completedJobs  Int                @default(0)
  acceptanceRate Float              @default(1)
  commissionPct  Float?
  bio            String?
  documents      PartnerDocument[]
  services       PartnerService[]
  availability   AvailabilitySlot[]
  bookings       Booking[]
  earnings       Earning[]
  payouts        Payout[]
  favorites      FavoritePartner[]
  reviews        Review[]
}

model PartnerDocument {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  type      String // AADHAAR, PAN, LICENSE, SELFIE
  s3Key     String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AvailabilitySlot {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])
  weekday   Int // 0-6
  startMin  Int // minutes from midnight
  endMin    Int

  @@index([partnerId, weekday])
}

model ServiceCategory {
  id            String               @id @default(cuid())
  slug          String               @unique
  name          Json // { en: "...", hi: "..." }
  iconUrl       String?
  sortOrder     Int                  @default(0)
  active        Boolean              @default(true)
  subCategories ServiceSubCategory[]
}

model ServiceSubCategory {
  id         String          @id @default(cuid())
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id])
  slug       String          @unique
  name       Json
  services   Service[]
}

model Service {
  id            String             @id @default(cuid())
  subCategoryId String
  subCategory   ServiceSubCategory @relation(fields: [subCategoryId], references: [id])
  townId        String?
  town          Town?              @relation(fields: [townId], references: [id])
  name          Json
  description   Json?
  basePrice     Decimal            @db.Decimal(10, 2)
  durationMin   Int                @default(60)
  gstPct        Float              @default(18)
  hsnCode       String?            @default("9954")
  active        Boolean            @default(true)
  partners      PartnerService[]
  bookings      Booking[]

  @@index([subCategoryId])
}

model PartnerService {
  partnerId   String
  serviceId   String
  partner     Partner  @relation(fields: [partnerId], references: [id])
  service     Service  @relation(fields: [serviceId], references: [id])
  customPrice Decimal? @db.Decimal(10, 2)

  @@id([partnerId, serviceId])
}

model PricingRule {
  id         String  @id @default(cuid())
  name       String
  startHour  Int? // peak window
  endHour    Int?
  weekdays   Int[]
  multiplier Float   @default(1)
  active     Boolean @default(true)
}

model Booking {
  id              String             @id @default(cuid())
  code            String             @unique
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id])
  partnerId       String?
  partner         Partner?           @relation(fields: [partnerId], references: [id])
  serviceId       String
  service         Service            @relation(fields: [serviceId], references: [id])
  addressId       String
  address         Address            @relation(fields: [addressId], references: [id])
  status          BookingStatus      @default(PENDING_PAYMENT)
  isInstant       Boolean            @default(false)
  scheduledAt     DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  cancelReason    String?
  rescheduledFrom DateTime?
  completionOtp   String?
  basePrice       Decimal            @db.Decimal(10, 2)
  surgeAmount     Decimal            @default(0) @db.Decimal(10, 2)
  discount        Decimal            @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal            @db.Decimal(10, 2)
  total           Decimal            @db.Decimal(10, 2)
  couponId        String?
  coupon          Coupon?            @relation(fields: [couponId], references: [id])
  paymentMethod   PaymentMethod
  payments        Payment[]
  invoice         Invoice?
  review          Review?
  earning         Earning?
  messages        ChatMessage[]
  tickets         SupportTicket[]
  statusLog       BookingStatusLog[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([customerId])
  @@index([partnerId, status])
  @@index([status, scheduledAt])
}

model BookingStatusLog {
  id        String        @id @default(cuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id])
  status    BookingStatus
  lat       Float?
  lng       Float?
  at        DateTime      @default(now())
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id])
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  refundedAmount    Decimal       @default(0) @db.Decimal(10, 2)
  createdAt         DateTime      @default(now())
}

model Invoice {
  id           String   @id @default(cuid())
  number       String   @unique
  bookingId    String   @unique
  booking      Booking  @relation(fields: [bookingId], references: [id])
  taxableValue Decimal  @db.Decimal(10, 2)
  cgst         Decimal  @db.Decimal(10, 2)
  sgst         Decimal  @db.Decimal(10, 2)
  igst         Decimal  @default(0) @db.Decimal(10, 2)
  total        Decimal  @db.Decimal(10, 2)
  pdfKey       String?
  issuedAt     DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  rating    Int
  comment   String?
  reply     String?
  createdAt DateTime @default(now())
}

model FavoritePartner {
  customerId String
  partnerId  String
  customer   Customer @relation(fields: [customerId], references: [id])
  partner    Partner  @relation(fields: [partnerId], references: [id])

  @@id([customerId, partnerId])
}

model Wallet {
  id      String      @id @default(cuid())
  userId  String      @unique
  user    User        @relation(fields: [userId], references: [id])
  balance Decimal     @default(0) @db.Decimal(12, 2)
  txns    WalletTxn[]
}

model WalletTxn {
  id        String   @id @default(cuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  type      TxnType
  amount    Decimal  @db.Decimal(12, 2)
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
}

model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  type         DiscountType
  value        Decimal      @db.Decimal(10, 2)
  maxDiscount  Decimal?     @db.Decimal(10, 2)
  minOrder     Decimal      @default(0) @db.Decimal(10, 2)
  usageLimit   Int?
  perUserLimit Int          @default(1)
  usedCount    Int          @default(0)
  validFrom    DateTime
  validTo      DateTime
  active       Boolean      @default(true)
  bookings     Booking[]
}

model Earning {
  id         String   @id @default(cuid())
  partnerId  String
  partner    Partner  @relation(fields: [partnerId], references: [id])
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  gross      Decimal  @db.Decimal(10, 2)
  commission Decimal  @db.Decimal(10, 2)
  net        Decimal  @db.Decimal(10, 2)
  settled    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([partnerId, createdAt])
}

model Payout {
  id          String       @id @default(cuid())
  partnerId   String
  partner     Partner      @relation(fields: [partnerId], references: [id])
  amount      Decimal      @db.Decimal(10, 2)
  status      PayoutStatus @default(REQUESTED)
  upiId       String?
  bankAccount String?
  reference   String?
  createdAt   DateTime     @default(now())
  processedAt DateTime?
}

model SupportTicket {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  bookingId  String?
  booking    Booking?     @relation(fields: [bookingId], references: [id])
  subject    String
  body       String
  status     TicketStatus @default(OPEN)
  isDispute  Boolean      @default(false)
  resolution String?
  createdAt  DateTime     @default(now())
}

model ChatMessage {
  id        String    @id @default(cuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id])
  senderId  String
  sender    User      @relation(fields: [senderId], references: [id])
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([bookingId, createdAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, createdAt])
}

model MembershipPlan {
  id           String     @id @default(cuid())
  name         String
  price        Decimal    @db.Decimal(10, 2)
  durationDays Int
  discountPct  Float      @default(0)
  freeSurge    Boolean    @default(false)
  customers    Customer[]
}

model Banner {
  id        String  @id @default(cuid())
  title     String
  imageUrl  String
  link      String?
  townId    String?
  town      Town?   @relation(fields: [townId], references: [id])
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model ContentPage {
  id    String @id @default(cuid())
  slug  String @unique
  title Json
  body  Json
}

model Setting {
  key   String @id
  value Json
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  amount           Decimal  @db.Decimal(10, 2)
  reason           String
  status           String   @default("PROCESSED") // REQUESTED | PROCESSED | REJECTED
  razorpayRefundId String?
  createdAt        DateTime @default(now())
}

model LoyaltyTxn {
  id         String   @id @default(cuid())
  customerId String
  points     Int // + earn, - redeem
  reason     String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model MembershipPurchase {
  id         String   @id @default(cuid())
  customerId String
  planId     String
  amount     Decimal  @db.Decimal(10, 2)
  startsAt   DateTime
  endsAt     DateTime
  paymentRef String?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
